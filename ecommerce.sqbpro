<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="ecommerce.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1123"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="ecommerce_data" custom_title="0" dock_id="2" table="4,14:mainecommerce_data"/><dock_state state="000000ff00000000fd0000000100000002000002480000020bfc0100000002fb000000160064006f0063006b00420072006f00770073006500310100000000000002480000000000000000fb000000160064006f0063006b00420072006f00770073006500320100000000000002480000013900ffffff000002480000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="ecommerce_data" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="65"/><column index="2" value="67"/><column index="3" value="280"/><column index="4" value="56"/><column index="5" value="124"/><column index="6" value="59"/><column index="7" value="75"/><column index="8" value="117"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 2*">SELECT * FROM ecommerce_data LIMIT 10;</sql><sql name="SQL 1*">SELECT * 
FROM ecommerce_data
WHERE Country = 'United Kingdom'
LIMIT 10;</sql><sql name="SQL 3*">SELECT *
FROM ecommerce_data
ORDER BY Quantity DESC
LIMIT 10;</sql><sql name="SQL 4*">SELECT Country,
       SUM(Quantity) AS Total_Quantity
FROM ecommerce_data
GROUP BY Country
ORDER BY Total_Quantity DESC;</sql><sql name="SQL 5*">SELECT Country,
       AVG(UnitPrice) AS Average_Price
FROM ecommerce_data
GROUP BY Country
ORDER BY Average_Price DESC;</sql><sql name="SQL 6*">SELECT Country,
       COUNT(InvoiceNo) AS Total_Orders
FROM ecommerce_data
GROUP BY Country
ORDER BY Total_Orders DESC;</sql><sql name="SQL 7*">SELECT Country,
       COUNT(InvoiceNo) AS Total_Orders
FROM ecommerce_data
GROUP BY Country
HAVING COUNT(InvoiceNo) &gt; 1000
ORDER BY Total_Orders DESC;</sql><sql name="SQL 8*">SELECT Description,
       Quantity
FROM ecommerce_data
WHERE Quantity &gt; (
    SELECT AVG(Quantity)
    FROM ecommerce_data
);</sql><sql name="SQL 9*">CREATE VIEW country_sales_view AS
SELECT Country,
       SUM(Quantity) AS Total_Quantity,
       AVG(UnitPrice) AS Average_Price
FROM ecommerce_data
GROUP BY Country;

SELECT * FROM country_sales_view;</sql><current_tab id="8"/></tab_sql></sqlb_project>
